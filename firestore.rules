rules_version = '2';

// ===============================================================
// ParsaPlan 2.1 - Standardized Cloud Firestore Security Rules
// Local-First Subcollections + Scalable Leaderboard + YPT Study Rooms
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Root Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------
    // Private User Profile & Subcollections (Never allow geminiApiKey)
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        (!('settings' in request.resource.data) || !('geminiApiKey' in request.resource.data.settings));
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /flashcards/{cardId} {
        allow read, write: if isOwner(userId);
      }

      match /pages/{pageId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------
    // Standardized Scalable Public Leaderboard (Lean Index + Lazy Detail)
    // ---------------------------------------------------------------
    match /publicProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(profileId) &&
        request.resource.data.xp is number &&
        request.resource.data.xp >= 0;
      allow delete: if isOwner(profileId);
    }

    match /publicProfileDetails/{profileId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(profileId);
    }

    // ---------------------------------------------------------------
    // Public Live Study Cabins (Indexed by lastPing)
    // ---------------------------------------------------------------
    match /liveSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(sessionId);
    }

    // ---------------------------------------------------------------
    // YPT-Style Group Study Rooms (Public Directory + 6-Char Invite Code)
    // ---------------------------------------------------------------
    match /study_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        (!('maxMembers' in request.resource.data) || (request.resource.data.maxMembers is int && request.resource.data.maxMembers >= 2 && request.resource.data.maxMembers <= 200)) &&
        (!('targetHours' in request.resource.data) || (request.resource.data.targetHours is number && request.resource.data.targetHours >= 1 && request.resource.data.targetHours <= 16));
      allow update, delete: if isAuthenticated() &&
        resource.data.creatorId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(memberId);
        // Member manages own row; room peers may only increment cheersReceived by 1
        allow update: if isOwner(memberId) || (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheersReceived']) &&
          request.resource.data.cheersReceived is number &&
          request.resource.data.cheersReceived == resource.data.cheersReceived + 1
        );
      }

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }
    }
  }
}
