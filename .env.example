# Server-side Gemini API Key (Google AI Studio free tier works - set in Vercel Environment Variables & local .env)
GEMINI_API_KEY=

# Global Firebase Configuration (shared Spark-plan project across all users - set in Vercel Environment Variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
